# NASA Open APIs key (DEMO_KEY works with stricter rate limits)
NASA_API_KEY=DEMO_KEY

# Local Express API port; vite.config.ts proxies /api to this port
PORT=3001

# Firebase Web app configuration (copy values from Firebase project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Hosted NASA API URL; leave blank for the local Vite proxy
VITE_API_BASE_URL=
